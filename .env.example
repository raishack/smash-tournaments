PORT=4000
POSTGRES_DB=tournament_manager
POSTGRES_USER=tournament_user
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql://tournament_user:change_this_postgres_password@db:5432/tournament_manager
APP_CLIENT_KEY=replace_with_your_app_client_key
ADMIN_DELETE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_GROUP_JID=
WHATSAPP_WACLI_BIN=/usr/local/bin/wacli
WACLI_AUTO_UPDATE=false
DISPLAY_ADMIN_DATA_DIR=/app/data/display-admin
DISPLAY_ADMIN_DATA_HOST_DIR=./data/display-admin
ANDROID_APP_UPDATES_DIR=/app/data/android-updates
ANDROID_APP_UPDATES_HOST_DIR=./data/android-updates
WINDOWS_APP_UPDATES_DIR=/app/data/windows-updates
WINDOWS_APP_UPDATES_HOST_DIR=./data/windows-updates
STARTGG_API_TOKEN=
STARTGG_OAUTH_CLIENT_ID=
STARTGG_OAUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=https://your-domain.example
SEED_DEMO_DATA=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional registration email. Use this installation's own SMTP credentials.
REGISTRATION_MAIL_FROM=
REGISTRATION_SMTP_HOST=
REGISTRATION_SMTP_PORT=587
REGISTRATION_SMTP_SECURE=false
REGISTRATION_SMTP_USER=
REGISTRATION_SMTP_PASSWORD=

# Initial management/display account. Used only on a fresh installation.
# Existing installations keep their users; there is no shared default password.
MANAGEMENT_BOOTSTRAP_USERNAME=
MANAGEMENT_BOOTSTRAP_PASSWORD=
